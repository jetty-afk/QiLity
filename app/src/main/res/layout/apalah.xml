<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back3"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="51dp" />

    <ImageView
        android:id="@+id/imageviewww"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="centerCrop"
        android:background="#E0E0E0"
        android:contentDescription="Preview Image" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="* Ensure the flash is turned on before capturing an image"
        android:textSize="11sp"
        android:textColor="@color/very_light_gray"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/georama_medium"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/newimagelagi"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:background="@drawable/custom3"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="@color/black"
        android:fontFamily="@font/questrial_egular"
        android:textStyle="bold"
        android:textSize="14sp"
        android:text="New Image"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/timelagi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="Exposure Time (T) (s):"
        android:fontFamily="@font/questrial_egular"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <EditText
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true"
        android:text=""
        android:textColor="@color/white"
        android:textSize="20sp"
        android:fontFamily="@font/timesnewromanbold"
        android:textStyle="bold"
        android:id="@+id/tampilkanTlagi"
        android:layout_gravity="center_horizontal"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/startdetectiondualagi"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/custom3"
        android:fontFamily="@font/questrial_egular"
        android:gravity="center"
        android:letterSpacing="-0.0"
        android:textStyle="bold"
        android:text="Start Detection"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nilaiNlagi"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Number of pixels (N)"
            android:fontFamily="@font/questrial_egular"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/nilaiIlagi"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Intensity value (I)"
            android:fontFamily="@font/questrial_egular"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/nilaiSigmaIlagi"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sigma I value (ΣI)"
            android:textStyle="bold"
            android:fontFamily="@font/questrial_egular"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="80dp"
            android:layout_height="47dp"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"
            android:textStyle="bold"
            android:text=""
            android:fontFamily="@font/timesnewromanbold"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:id="@+id/tampilanNlagi"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="80dp"
            android:layout_height="47dp"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/timesnewromanbold"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/white"
            android:textSize="20sp"
            android:id="@+id/tampilanIlagi"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="80dp"
            android:layout_height="47dp"
            android:layout_weight="1"
            android:fontFamily="@font/timesnewromanbold"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:text=""
            android:textColor="@color/white"
            android:textSize="20sp"
            android:id="@+id/tampilansigmaIlagi"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/simpandatalagi"
            android:layout_width="155dp"
            android:layout_height="45dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/custom6"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="SAVE"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="2dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/next"
            android:gravity="center"
            android:layout_width="155dp"
            android:layout_height="45dp"
            android:background="@drawable/custom7"
            android:fontFamily="@font/questrial_egular"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13.5sp"
            android:text="NEXT ->>>"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</LinearLayout>