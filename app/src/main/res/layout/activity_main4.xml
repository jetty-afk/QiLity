<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back3"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"/>

    <ImageView
        android:id="@+id/imagevieww"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="centerCrop"
        android:background="#E0E0E0"
        android:contentDescription="Preview Image" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="* Ensure the flash is turned on before capturing an image"
        android:textSize="11sp"
        android:textColor="@color/very_light_gray"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/georama_medium"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/newimage"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:background="@drawable/custom3"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="@color/black"
        android:fontFamily="@font/questrial_egular"
        android:textStyle="bold"
        android:textSize="14sp"
        android:text="New Image"
        android:layout_marginTop="16dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/concentration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Concentration (C) (nmol/L):"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="3dp"
            android:layout_height="2dp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Exposure Time (T) (s):"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <EditText
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_centerHorizontal="true"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:textSize="25sp"
            android:id="@+id/tampilkanC"
            android:fontFamily="@font/timesnewromanbold"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"/>

        <EditText
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_centerHorizontal="true"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="25sp"
            android:fontFamily="@font/timesnewromanbold"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tampilkanT"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startdetectionsatu"
            android:layout_width="155dp"
            android:layout_height="45dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/custom3"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Start Detection blank sample"
            android:textColor="@color/black"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="10dp"
            android:layout_height="2dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startdetectiondua"
            android:layout_width="155dp"
            android:layout_height="45dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/custom3"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Start Detection with sample"
            android:textColor="@color/black"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nilaiN"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Number of pixels (N)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nilaiI"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Intensity value (I)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nilaiSigmaI"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="Sigma I value (∑I)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tampilanN"
            android:layout_width="80dp"
            android:layout_height="47dp"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:fontFamily="@font/timesnewromanbold"
            android:text=""
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="47dp"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/timesnewromanbold"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/white"
            android:textSize="20sp"
            android:id="@+id/tampilanI"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="80dp"
            android:layout_height="47dp"
            android:layout_weight="1"
            android:fontFamily="@font/timesnewromanbold"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:text=""
            android:textColor="@color/white"
            android:textSize="20sp"
            android:id="@+id/tampilansigmaI"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/simpandata"
            android:layout_width="155dp"
            android:layout_height="45dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/custom6"
            android:fontFamily="@font/questrial_egular"
            android:gravity="center"
            android:text="SAVE"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="2dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/finish"
            android:gravity="center"
            android:layout_width="155dp"
            android:layout_height="45dp"
            android:background="@drawable/custom7"
            android:fontFamily="@font/questrial_egular"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13.5sp"
            android:text="finish ->>>"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</LinearLayout>