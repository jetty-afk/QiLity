
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TheQuality" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:buttonStyle">@style/CustomButton</item>
    </style>
    <style name="Custom" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/custom</item>
        <item name="backgroundTint">@null</item> <!-- Hindari override warna background -->
    </style>

    <style name="CustomButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item> <!-- Menonaktifkan warna default button -->
    </style>
    <style name="Theme.NamaAplikasi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimaryVariant">@color/warnaBaru</item>
        <item name="android:statusBarColor">@color/warnaBaru</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
